#!/bin/bash
# Switch existing Git worktrees through Rex or the Herdr desktop app.
# Compatible with the Bash 3.2 shipped by macOS.
set -euo pipefail
umask 077

VERSION=0.1.0
host=auto
source_dir=$PWD
requested_path=
scope=
list_only=false
scratch=
lock_dir=
locked=false
pending_state=

usage() {
    cat <<'HELP'
Usage: wt-switch [options]

  --host rex|herdr      Host (auto-detected inside a terminal)
  --cwd DIR            Repository directory; defaults to the current directory
  --scope ID           Rex session ID or Herdr space ID
  --path DIR           Select this existing worktree without opening fzf
  --list               Print available worktrees as JSON without contacting a host
  --version            Print the version
  -h, --help           Show this help

Enter selects; Escape/Ctrl-C cancels. Never creates or removes Git worktrees.
HELP
}
fail() { printf 'wt-switch: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1"; }
cleanup() {
    if [[ -n $pending_state ]]; then rm -f -- "$pending_state"; fi
    if [[ $locked == true ]]; then
        rm -f -- "$lock_dir/pid"
        rmdir -- "$lock_dir" 2>/dev/null || true
    fi
    if [[ -n $scratch ]]; then rm -rf -- "$scratch"; fi
}
on_exit() {
    local exit_status=$?
    cleanup
    exit "$exit_status"
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

while (($#)); do
    case $1 in
        --host|--cwd|--scope|--path)
            (($# >= 2)) || fail "Missing value for $1"
            [[ -n $2 ]] || fail "Empty value for $1"
            case $1 in
                --host) host=$2 ;; --cwd) source_dir=$2 ;;
                --scope) scope=$2 ;; --path) requested_path=$2 ;;
            esac
            shift 2 ;;
        --list) list_only=true; shift ;;
        --version) printf '%s\n' "$VERSION"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        *) fail "Unknown option: $1 (see --help)" ;;
    esac
done
case $host in auto|rex|herdr) ;; *) fail "Unsupported host: $host" ;; esac
need git
need jq

# Rex reports cwd as a file URL. Decode only percent triplets, never shell text.
decode_path() {
    local value=$1 prefix hex char decoded=
    if [[ $value == file://* ]]; then
        value=${value#file://}
        [[ $value == */* ]] || return 1
        value=/${value#*/}
        while [[ -n $value ]]; do
            prefix=${value:0:1}
            if [[ $prefix == '%' ]]; then
                hex=${value:1:2}
                [[ ${#hex} == 2 && $hex != *[!0-9a-fA-F]* && $hex != 00 ]] || return 1
                printf -v char '%b' "\\x$hex"
                decoded=$decoded$char
                value=${value:3}
            else
                decoded=$decoded$prefix
                value=${value:1}
            fi
        done
        value=$decoded
    fi
    # Control characters cannot be represented safely in a one-line picker.
    if printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then return 1; fi
    printf '%s\n' "$value"
}
canonical_dir() {
    local value
    value=$(decode_path "$1") || return 1
    (cd -- "$value" 2>/dev/null && pwd -P)
}
source_dir=$(canonical_dir "$source_dir") || fail 'Repository directory is unavailable or contains control characters'
scratch=$(mktemp -d "${TMPDIR:-/tmp}/mux-tools.XXXXXXXX")
git -C "$source_dir" worktree list --porcelain -z > "$scratch/worktrees.raw" || fail 'The directory is not a Git repository'

emit_worktree() {
    local physical
    [[ -n $worktree && $bare == false ]] || return 0
    physical=$(canonical_dir "$worktree") || return 0
    [[ -n $branch ]] || branch="detached:${head:0:8}"
    jq -cn --arg path "$physical" --arg branch "$branch" \
        '{path:$path,branch:$branch}' >> "$scratch/worktrees.ndjson"
}
worktree='' branch='' head='' bare=false
: > "$scratch/worktrees.ndjson"
while IFS= read -r -d '' field; do
    case $field in
        'worktree '*) worktree=${field#worktree } ;;
        'branch '*) branch=${field#branch refs/heads/} ;;
        'HEAD '*) head=${field#HEAD } ;;
        bare) bare=true ;;
        '') emit_worktree; worktree=; branch=; head=; bare=false ;;
    esac
done < "$scratch/worktrees.raw"
jq -s 'unique_by(.path)' "$scratch/worktrees.ndjson" > "$scratch/worktrees.json"
[[ $(jq length "$scratch/worktrees.json") != 0 ]] || fail 'No available non-bare worktrees found'
if [[ $list_only == true ]]; then cat "$scratch/worktrees.json"; exit 0; fi

if [[ -n $requested_path ]]; then
    target=$(canonical_dir "$requested_path") || fail 'Selected directory is unavailable'
else
    need fzf
    jq -r 'to_entries[] | [(.key|tostring),.value.branch,.value.path] | @tsv' \
        "$scratch/worktrees.json" > "$scratch/menu"
    # Ignore user defaults that could turn a single selection into an action.
    status=0
    choice=$(FZF_DEFAULT_OPTS='' FZF_DEFAULT_OPTS_FILE='' fzf \
        --no-multi --delimiter=$'\t' --with-nth=2.. --height=80% --layout=reverse \
        --border --prompt='Worktree> ' --header='Enter: switch tab   Esc: cancel' \
        < "$scratch/menu") || status=$?
    case $status in 0) ;; 1|130) exit 0 ;; *) fail "fzf failed (exit $status)" ;; esac
    index=${choice%%$'\t'*}
    [[ -n $index && $index != *[!0-9]* ]] || fail 'Invalid picker selection'
    target=$(jq -er --argjson i "$index" '.[$i].path // empty' "$scratch/worktrees.json") || fail 'Invalid picker selection'
fi
branch=$(jq -er --arg p "$target" '.[] | select(.path==$p) | .branch' "$scratch/worktrees.json") || fail 'Selected path is not a worktree of this repository'
[[ -d $target ]] || fail 'Selected worktree disappeared; run the picker again'

# Nested Herdr-in-Rex shells belong to the inner host.
if [[ $host == auto ]]; then
    if [[ -n ${HC_TERMINAL_ID:-} ]]; then host=herdr
    elif [[ -n ${REX_SESSION:-} ]]; then host=rex
    else fail 'Cannot detect a host; pass --host rex or --host herdr'; fi
fi
find_binary() {
    local configured=$1 name=$2 fallback=${3:-}
    if [[ -n $configured ]]; then
        command -v "$configured" || return 1
    elif command -v "$name" >/dev/null 2>&1; then command -v "$name"
    elif [[ -n $fallback && -x $fallback ]]; then printf '%s\n' "$fallback"
    else return 1; fi
}
if [[ $host == rex ]]; then
    rex_bin=$(find_binary "${MUX_TOOLS_REX_BIN:-}" rex '/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex') || fail 'rex CLI not found'
    scope=${scope:-${REX_SESSION:-}}
    if [[ -n $scope ]]; then
        "$rex_bin" window ls -s "$scope" --json > "$scratch/topology.json" || fail 'Cannot inspect Rex tabs'
    else
        "$rex_bin" window ls --json > "$scratch/topology.json" || fail 'Cannot inspect Rex tabs'
    fi
    scope=$(jq -er '.session_id | select(type=="string" and length>0)' "$scratch/topology.json") || fail 'Unexpected Rex window list'
    "$rex_bin" whoami --json > "$scratch/server.json" || fail 'Cannot identify Rex server'
    identity=$(jq -cer --arg scope "$scope" '{host:"rex",endpoint:.endpoint,instance:.instance_id,scope:$scope} | select(.endpoint|type=="string")' "$scratch/server.json") || fail 'Unexpected Rex server identity'
    jq -e '.windows | type=="array"' "$scratch/topology.json" >/dev/null || fail 'Unexpected Rex window list'
    jq '[.windows[].window_id]' "$scratch/topology.json" > "$scratch/live.json"
else
    herdr_bin=$(find_binary "${MUX_TOOLS_HERDR_BIN:-}" herdr-app "$HOME/.local/bin/herdr-app") || fail 'herdr-app CLI not found (Herdr desktop app required)'
    hc_bin=$(find_binary "${MUX_TOOLS_HC_BIN:-}" hc "$HOME/.local/bin/hc") || fail 'hc CLI not found'
    "$herdr_bin" ls > "$scratch/topology.json" || fail 'Cannot inspect Herdr tabs'
    jq -e '.spaces | type=="array"' "$scratch/topology.json" >/dev/null || fail 'Unexpected Herdr space list'
    if [[ -z $scope && -n ${HC_TERMINAL_ID:-} ]]; then
        scope=$(jq -er --arg t "$HC_TERMINAL_ID" '.spaces[] | select(any(.tabs[].terminals[]; .terminal==$t)) | .id' "$scratch/topology.json") || fail 'Calling terminal is not in a Herdr space; pass --scope explicitly'
    elif [[ -z $scope ]]; then
        scope=$(jq -er '.spaces[] | select(.active) | .id' "$scratch/topology.json") || fail 'No active Herdr space; pass --scope explicitly'
    fi
    jq -e --arg s "$scope" '.spaces[] | select(.id==$s and (.machine==null or .machine==""))' "$scratch/topology.json" >/dev/null || fail 'Herdr space is missing or remote; only local spaces are supported'
    identity=$(jq -cn --arg home "${HERDR_APP_HOME:-$HOME/.config/herdr-app}" --arg core "${HC_SESSION:-default}" --arg scope "$scope" '{host:"herdr",app_home:$home,core:$core,scope:$scope}')
    jq --arg s "$scope" '[.spaces[] | select(.id==$s) | .tabs[].id]' "$scratch/topology.json" > "$scratch/live.json"
fi

state_root=${MUX_TOOLS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mux-tools}
mkdir -p -- "$state_root"
# No repository writes: Git supplies a portable digest without another dependency.
state_key=$(printf '%s' "$identity" | git -C "$scratch" hash-object --stdin)
state_file=$state_root/$state_key.json
lock_dir=$state_root/$state_key.lock
for ((attempt=0; attempt<50; attempt++)); do
    if mkdir -- "$lock_dir" 2>/dev/null; then locked=true; break; fi
    sleep 0.1
done
[[ $locked == true ]] || fail "Another switch is running, or a stale lock exists: $lock_dir"
printf '%s\n' "$$" > "$lock_dir/pid"

# Refresh under the lock: another picker may have created a tab while we waited.
if [[ $host == rex ]]; then
    "$rex_bin" window ls -s "$scope" --json > "$scratch/topology.json" || fail 'Cannot refresh Rex tabs'
    jq -e '.windows | type=="array"' "$scratch/topology.json" >/dev/null || fail 'Unexpected Rex window list'
    jq '[.windows[].window_id]' "$scratch/topology.json" > "$scratch/live.json"
else
    "$herdr_bin" ls > "$scratch/topology.json" || fail 'Cannot refresh Herdr tabs'
    jq -e --arg s "$scope" '.spaces[] | select(.id==$s and (.machine==null or .machine==""))' "$scratch/topology.json" >/dev/null || fail 'Herdr space is missing or remote'
    jq --arg s "$scope" '[.spaces[] | select(.id==$s) | .tabs[].id]' "$scratch/topology.json" > "$scratch/live.json"
fi
if [[ -f $state_file ]]; then
    jq -e --argjson identity "$identity" '.identity==$identity and (.tabs|type=="object") and all(.tabs[]; type=="string")' "$state_file" >/dev/null || fail "Invalid state file; move it aside and retry: $state_file"
    jq --slurpfile live "$scratch/live.json" '.tabs |= with_entries(select(.value as $id | $live[0] | index($id)))' "$state_file" > "$scratch/state.json"
else
    jq -n --argjson identity "$identity" '{identity:$identity,tabs:{}}' > "$scratch/state.json"
fi
id=$(jq -r --arg p "$target" '.tabs[$p] // empty' "$scratch/state.json")

same_worktree() {
    local dir root
    dir=$(canonical_dir "$1") || return 1
    root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || return 1
    root=$(canonical_dir "$root") || return 1
    [[ $root == "$target" ]]
}
# Adopt already-open terminals by their real repository directory, not a title.
if [[ -z $id ]]; then
    if [[ $host == rex ]]; then
        jq -r '.windows[] | .window_id as $w | .layers[] | select(.kind=="tiled") | .blocks[] | select(.creator_name=="com.superlogical.terminal") | [$w,.block_id] | @tsv' "$scratch/topology.json" > "$scratch/terminals"
        while IFS=$'\t' read -r tab terminal; do
            pwd_json=$("$rex_bin" block call -s "$scope" -b "$terminal" pwd 2>/dev/null) || continue
            cwd=$(printf '%s' "$pwd_json" | jq -er '.pwd | select(type=="string")') || continue
            if same_worktree "$cwd"; then id=$tab; break; fi
        done < "$scratch/terminals"
    else
        jq -r --arg s "$scope" '.spaces[] | select(.id==$s) | .tabs[] | .id as $t | .terminals[] | [$t,.terminal] | @tsv' "$scratch/topology.json" > "$scratch/terminals"
        while IFS=$'\t' read -r tab terminal; do
            terminal_json=$("$hc_bin" get "$terminal" --json 2>/dev/null) || continue
            cwd=$(printf '%s' "$terminal_json" | jq -er '.foreground.cwd // .cwd | select(type=="string")') || continue
            if same_worktree "$cwd"; then id=$tab; break; fi
        done < "$scratch/terminals"
    fi
fi
if [[ -n $id ]]; then
    if [[ $host == rex ]]; then "$rex_bin" window focus -s "$scope" "$id" >/dev/null || fail 'Cannot focus existing Rex tab; no new tab was created'
    else "$herdr_bin" 'do' tab.select "$(jq -cn --arg id "$id" '{id:$id}')" >/dev/null || fail 'Cannot focus existing Herdr tab; no new tab was created'; fi
    action=focused
else
    label=$(jq -nr --arg b "$branch" '$b[0:60]')
    if [[ $host == rex ]]; then
        created=$("$rex_bin" window new -s "$scope" --cwd "$target" --json "$label") || fail 'Cannot create Rex tab; inspect the host before retrying'
        id=$(printf '%s' "$created" | jq -er '.window_id | select(type=="string" and length>0)') || fail 'Unexpected create response; inspect Rex before retrying'
    else
        created=$("$herdr_bin" 'do' tab.new "$(jq -cn --arg space "$scope" --arg folder "$target" --arg name "$label" '{space:$space,folder:$folder,name:$name,focus:true}')") || fail 'Cannot create Herdr tab; inspect the host before retrying'
        id=$(printf '%s' "$created" | jq -er '.tab | select(type=="string" and length>0)') || fail 'Unexpected create response; inspect Herdr before retrying'
    fi
    action=created
fi
pending_state=$(mktemp "$state_file.XXXXXXXX")
jq --arg p "$target" --arg id "$id" '.tabs[$p]=$id' "$scratch/state.json" > "$pending_state"
mv -- "$pending_state" "$state_file"
pending_state=
printf '%s\n' "$action: $branch ($target)"
